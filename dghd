internal class Program
{ 
    static void Main(string[] args)
    {
        SayHello();
        Scitanie(4, 5);
        Odcitanie(10, 4);
    }

    public static void SayHello()
    {
        Console.WriteLine("Ahoj svet!");
    }

    public static void Scitanie(int a, int b)
    {
        int vysledok = a + b;
        Console.WriteLine("Výsledok sčítania: " + vysledok);
    }

    public static void Odcitanie(int a, int b)
    {
        int vysledok = a - b;
        Console.WriteLine("Výsledok odčítania: " + vysledok);
    }
}





}
