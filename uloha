using System;
using System.Windows;
using System.Windows.Threading;

namespace CodeCraft_Cookie_Clicker
{
    public partial class MainWindow : Window
    {
        // Premenné na sledovanie stavu hry
        private int cookieCount = 0;
        private int clickPower = 1;
        private int cookiesPerSecond = 0;

        private DispatcherTimer autoClickTimer;

        public MainWindow()
        {
            InitializeComponent();

            // Nastavenie časovača na každú 1 sekundu (pre automatickú výrobu z Továrne)
            autoClickTimer = new DispatcherTimer();
            autoClickTimer.Interval = TimeSpan.FromSeconds(1);
            autoClickTimer.Tick += AutoClickTimer_Tick;
            autoClickTimer.Start();

            UpdateUI();
        }

        // 1. Kliknutie na hlavné tlačidlo (Cookie)
        private void BtnCookie_Click(object sender, RoutedEventArgs e)
        {
            cookieCount += clickPower;
            UpdateUI();
        }

        // 2. Vylepšenie: Silnejší klik (+1 za klik, cena 10)
        private void BtnSilnejsiKlik_Click(object sender, RoutedEventArgs e)
        {
            int cost = 10;
            if (cookieCount >= cost)
            {
                cookieCount -= cost;
                clickPower += 1;
                UpdateUI();
            }
            else
            {
                MessageBox.Show("Nemáš dostatok cookies!", "Chyba", MessageBoxButton.OK, MessageBoxImage.Warning);
            }
        }

        // 3. Vylepšenie: Super klik (+10 za klik, cena 100)
        private void BtnSuperKlik_Click(object sender, RoutedEventArgs e)
        {
            int cost = 100;
            if (cookieCount >= cost)
            {
                cookieCount -= cost;
                clickPower += 10;
                UpdateUI();
            }
            else
            {
                MessageBox.Show("Nemáš dostatok cookies!", "Chyba", MessageBoxButton.OK, MessageBoxImage.Warning);
            }
        }

        // 4. Vylepšenie: Továreň (+100 za sekundu, cena 5000)
        private void BtnTovaren_Click(object sender, RoutedEventArgs e)
        {
            int cost = 5000;
            if (cookieCount >= cost)
            {
                cookieCount -= cost;
                cookiesPerSecond += 100;
                UpdateUI();
            }
            else
            {
                MessageBox.Show("Nemáš dostatok cookies!", "Chyba", MessageBoxButton.OK, MessageBoxImage.Warning);
            }
        }

        // Časovač prirátava každú sekundu pasívny príjem
        private void AutoClickTimer_Tick(object sender, EventArgs e)
        {
            if (cookiesPerSecond > 0)
            {
                cookieCount += cookiesPerSecond;
                UpdateUI();
            }
        }

        // Aktualizácia textov v okne
        private void UpdateUI()
        {
            txtCookies.Text = $"Cookies: {cookieCount}";
            txtClickPower.Text = $"Sila kliku: +{clickPower}";
            txtPerSecond.Text = $"Za sekundu: +{cookiesPerSecond}";
        }
    }
}
